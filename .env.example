# Copy to .env (git-ignored) and fill in. Never commit real keys.
#   cp .env.example .env && chmod 600 .env

# Fine-tuned reviewer / detector — Adaption Labs. Without it, the guard runs Layer 1 only.
ADAPTION_API_KEY=pt_live_YOUR_API_KEY

# Web reputation for the reviewer — Tavily (https://tavily.com). Only the domain is ever sent.
TAVILY_API_KEY=tvly-YOUR_API_KEY

# The coding agent's model endpoint (OpenAI-compatible, with tool calling).
# GPT-OSS 20B on this host, or an Ollama model such as gemma4:e2b.
AGENT_BASE_URL=http://127.0.0.1:8080/v1
AGENT_MODEL=gpt-oss-20b
AGENT_API_KEY=local

# Operator tooling (bank-mail / cview) reuses the same model server.
BANK_LLM_BASE=http://127.0.0.1:8080/v1
BANK_LLM_MODEL=gpt-oss-20b

# Optional: bank demo secret, used only via {{BANK_API_KEY}} placeholders at egress.
# BANK_API_KEY=fake-secret-for-local-demo
