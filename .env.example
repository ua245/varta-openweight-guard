# Copy to .env and fill in. Never commit real keys.
# Tavily: https://tavily.com  (Autonomous Agents bounty — Best use of Tavily)

TAVILY_API_KEY=tvly-YOUR_API_KEY
ADAPTIONLABS_API_KEY=pt_live_YOUR_API_KEY

# Researcher agent brain (guard/researcher.py): any OpenAI-compatible endpoint.
# Unset = first backend in llm_map.json; no backend = policy-only guard (escalations denied).
# RESEARCHER_BASE_URL=http://127.0.0.1:8080/v1
# RESEARCHER_MODEL=gpt-oss-20b          # falls back to FINE_TUNED_MODEL
# RESEARCHER_API_KEY=

# Optional: bank demo secret used only via {{BANK_API_KEY}} placeholders at egress
# BANK_API_KEY=fake-secret-for-local-demo
