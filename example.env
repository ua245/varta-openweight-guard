# Copy to .env (gitignored) and fill in. Never commit real keys.
# Optional layer-2 detector (Adaption Labs). Without a key the guard runs layer 1 only.
ADAPTION_API_KEY=pt_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Web search (Tavily). Never given to the agent: the guard injects it at egress
# for api.tavily.com only.
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model server for the agent (OpenAI-compatible)
# AGENT_BASE_URL=http://localhost:11434/v1
# AGENT_MODEL=gemma4:e2b
# AGENT_API_KEY=
